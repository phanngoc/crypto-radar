# ─────────────────────────────────────────────
# OKX API (cần cho live trading)
# ─────────────────────────────────────────────
OKX_API_KEY=your_api_key_here
OKX_SECRET=your_secret_here
OKX_PASSPHRASE=your_passphrase_here
OKX_SANDBOX=false          # true = sandbox mode (test)
OKX_MARKET_TYPE=spot       # spot | swap (futures/perp)

# ─────────────────────────────────────────────
# Telegram Notifications (tuỳ chọn)
# Tạo bot: t.me/BotFather → /newbot
# Chat ID: t.me/userinfobot
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# Agent Settings
# ─────────────────────────────────────────────
TRADING_MODE=paper         # paper | live

# Watchlist (OKX format: BASE/QUOTE)
AGENT_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,SUI/USDT,BNB/USDT

AGENT_TIMEFRAME=15m        # khung chính: 15m | 1h | 4h | 1d
AGENT_CONFIRM_TF=1h        # khung xác nhận (cao hơn timeframe)

AGENT_SCAN_INTERVAL=60     # giây giữa mỗi lần quét
AGENT_GUARDIAN_INTERVAL=1  # giây check SL/TP (1s với WebSocket)

AGENT_SIGNAL_THRESHOLD=30  # ngưỡng score để vào lệnh (±30 đến ±100)
AGENT_REQUIRE_CONFIRM=true # bắt TF xác nhận cùng chiều

AGENT_MAX_POSITIONS=3      # số lệnh mở tối đa cùng lúc
AGENT_CAPITAL_PER_TRADE=100.0  # USDT mỗi lệnh
AGENT_RISK_PCT=1.5         # % vốn rủi ro tối đa / lệnh

# Trailing Stop
AGENT_TRAILING_STOP=true
AGENT_TRAILING_ACTIVATION=1.5  # % lợi nhuận để kích hoạt trail
AGENT_TRAILING_DISTANCE=0.8    # % khoảng cách SL từ đỉnh/đáy

AGENT_COOLDOWN_BARS=3      # số nến chờ sau khi thoát lệnh
AGENT_MOMENTUM_BARS=3      # 0=tắt momentum filter, 2-5=bật

# WebSocket realtime price feed
AGENT_USE_WEBSOCKET=true   # false = dùng REST polling (chậm hơn)

# ─────────────────────────────────────────────
# Circuit Breaker (bảo vệ tài khoản)
# ─────────────────────────────────────────────
CIRCUIT_DAILY_LOSS_LIMIT=50      # USDT thua trong ngày → dừng entry
CIRCUIT_SESSION_LOSS_LIMIT=100   # USDT thua phiên → dừng agent
CIRCUIT_MAX_CONSEC_LOSSES=4      # lệnh thua liên tiếp → dừng tạm
