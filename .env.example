# === CRYPTO RADAR CONFIG ===
# Copy file này thành .env và điền thông tin

# --- Binance API (tùy chọn, chỉ cần cho giao dịch thực) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Cài đặt giao dịch ---
# Chế độ: paper (giả lập) hoặc live (thực)
TRADING_MODE=paper

# Sàn mặc định khi live trading
EXCHANGE=binance

# Tỉ lệ rủi ro tối đa mỗi lệnh (%)
DEFAULT_RISK_PCT=2.0

# Số lượng nến tải về để phân tích
CANDLE_LIMIT=300
